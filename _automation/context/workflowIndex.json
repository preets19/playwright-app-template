      "sanitizedRawCode": "test.describe('Regression', () => {\n  test('Filter by Series and Team', async ({ page }) => {\n    await page.goto('https://www.cricinfo.com/');\n    await expect(page.getByRole('navigation')).toContainText('Series');\n    await page.getByRole('link', { name: 'Series' }).click();\n    await expect(page.locator('#tippy-3'). ).getByRole('link', { name: 'Women\\'s T20 World Cup' }).toBeVisible();\n    await page.locator('#tippy-3').getByRole('link', { name: 'Women\\'s T20 World Cup' }).click();\n    await expect(page.locator('h1')).toContainText('ICC Women\\'s T20 World Cup 2026');\n    await page.getByRole('link', { name: 'Fixtures and Results' }).click();\n    await expect(page.locator('div').filter({ hasText: /^Teams$/ }).nth(2)).toBeVisible();\n    await page.locator('.icon-expand_more-outlined.ds-text-icon-inverse').first().click();\n    await page.getByRole('textbox', { name: 'search...' }).click();\n    await page.getByRole('textbox', { name: 'search...' }).fill('<redacted>');\n    await page.locator('#tippy-76').getByText('India Women').click();\n    await page.getByRole('button', { name: 'Apply' }).click();\n    await expect(page.locator('h1')).toContainText('ICC Women\\'s T20 World Cup Schedule & Match Results');\n    await expect(page.locator('#main-container')).toContainText('India Women');\n  });\n});",
